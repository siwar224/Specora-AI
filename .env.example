# --- OpenAI (used when either backend below is set to "openai") ---
OPENAI_API_KEY=your-openai-key

# =========================================================================
#  Two independent toggles: each stage can run in the cloud or on your machine
# =========================================================================

# --- Speech-to-text: "openai" (gpt-4o-transcribe) or "local" (Whisper) ---
TRANSCRIBE_BACKEND=openai
# Only used when TRANSCRIBE_BACKEND=local. Requires: pip install faster-whisper
# tiny | base | small | medium | large-v3  ("medium" is better for Arabic dialect)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# --- Understanding: "openai" (gpt-4o) or "local" (llama.cpp SLM) ---
UNDERSTAND_BACKEND=openai
#local
#UNDERSTAND_BACKEND=local

# Only used when UNDERSTAND_BACKEND=local. Start the server with:
#   llama-server -hf Qwen/Qwen2.5-1.5B-Instruct-GGUF -c 4096
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=qwen2.5-1.5b-instruct
